# The agent API.
#
# Build from the REPO ROOT, not from this directory:
#
#     docker build -f deploy/Dockerfile.api -t scipio-api .
#
# The build context has to be the root because this is a uv workspace: the API
# imports `curator_schema` and `curator_data` from `packages/schema/python` and
# `data/`, which are workspace members resolved from source, not wheels from an
# index. A context of `deploy/` cannot see them and the build fails at import
# time rather than at copy time, which is a slower way to learn the same thing.

FROM python:3.12-slim AS base

# uv rather than pip: the lockfile is `uv.lock` and it is what pins every
# transitive dependency. Installing from pyproject with pip would resolve fresh
# versions at build time, which is the exact supply-chain exposure the JS side
# of this repo has an audit script to prevent — see web/scripts/audit-dependency-age.mjs.
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /srv

# ── dependencies, cached separately from source ───────────────────────────
# Only the manifests are copied first, so editing a Python file does not
# reinstall web3 and its compiled dependencies. Each workspace member needs its
# own pyproject present or `uv sync` cannot resolve the workspace at all.
COPY pyproject.toml uv.lock ./
COPY packages/schema/python/pyproject.toml packages/schema/python/
COPY data/pyproject.toml data/
COPY data/curator_mcp/pyproject.toml data/curator_mcp/

# --no-install-WORKSPACE, not --no-install-project. The difference is the whole
# point of this layer.
#
# `--no-install-project` skips only the root package, so uv would still build
# and install the workspace members — `curator-data` and `curator-mcp`. Both
# declare `readme = "README.md"` in their pyproject, their build backend reads
# it, and at this point only the pyproject files have been copied. The failure
# is `OSError: Readme file does not exist`, from inside a layer whose purpose is
# to install third-party dependencies and nothing else.
#
# `--no-install-workspace` skips the root and every member, which is exactly
# what a dependency-cache layer wants. The members are installed by the second
# sync below, once their source (and their READMEs) is present.
#
# --frozen: fail if uv.lock disagrees with pyproject rather than silently
# resolving something new inside an image nobody will read.
RUN uv sync --frozen --no-install-workspace --extra agent --extra venues --extra data

# ── application source ────────────────────────────────────────────────────
COPY packages/ packages/
COPY data/ data/
COPY agent/ agent/
COPY venues/ venues/
COPY deployments/ deployments/
# Flat ABIs, read by `agent/chain/abi.py`. Without them `load_abi` silently
# degrades to a minimal bundled fallback — the API starts and answers /health,
# then 500s on any call reaching a function the fallback lacks.
COPY contracts/abis/ contracts/abis/

RUN uv sync --frozen --extra agent --extra venues --extra data

ENV PATH="/opt/venv/bin:$PATH"

# `agent` and `venues` are NOT installed packages. The root pyproject declares no
# `[build-system]`, so uv treats it as a virtual project and installs only the
# workspace members (`curator_schema`, `curator_data`); the two lanes are
# imported from the working directory instead.
#
# uvicorn does insert its `--app-dir` (default ".") into sys.path, so this is
# belt-and-braces — but a console script's sys.path[0] is /opt/venv/bin, not the
# cwd, so if that behaviour ever changed the failure would be
# `ModuleNotFoundError: agent` at container start, which reads as a broken image
# rather than a path assumption.
ENV PYTHONPATH=/srv

# Mandates, the decision journal, performance history and every open Aqua
# position live here. Mount a volume over it — see docker-compose.yml. Aqua can
# confirm a strategy hash you already hold but offers no way to enumerate a
# maker's positions, so a lost record is a position that can never be displayed
# or closed. This is not a cache.
ENV AGENT_STATE_DIR=/var/lib/scipio/state
RUN mkdir -p /var/lib/scipio/state

EXPOSE 8000

# `mode` is checked, not just `status`. A fixture-mode API answers every request
# and validates every response over invented data, so a healthcheck that only
# looked for HTTP 200 would report a stack serving fiction as healthy.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import sys,urllib.request,json; \
b=json.load(urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=4)); \
sys.exit(0 if b.get('status')=='ok' and b.get('mode')=='live' else 1)"

# No --reload. It watches the filesystem, doubles memory, and restarts the
# process on a file event, which on a machine that also runs a deploy is a
# restart in the middle of a tick.
CMD ["uvicorn", "agent.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
