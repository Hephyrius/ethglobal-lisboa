# solc resolves imports by walking real directories. pnpm's default symlinked
# store makes import resolution fragile for the compiler, so this project uses a
# flat, real node_modules tree.
node-linker=hoisted

# This project is NOT a member of the root pnpm workspace (pnpm-workspace.yaml
# covers only packages/schema/ts and web). pnpm still walks up and finds that
# workspace, and would then install the ROOT workspace's dependencies here while
# ignoring this package.json entirely — which is what happened the first time.
# There is no .npmrc key for this; it must be the CLI flag, so install with:
#
#     pnpm install --ignore-workspace
#
# The Makefile target and docs/setup instructions both use it.
