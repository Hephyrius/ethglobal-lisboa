# Copy to .env and fill in. .env is gitignored; this template is not.
# Full rationale for each key: plans/2026-07-25-master-build-plan.md §8.1

# ── BLOCKING — nothing works without these three ──────────────────────────

# Uniswap Developer Platform → https://developers.uniswap.org/dashboard
# Gates the entire $7K Uniswap track. Owner: Lane D.
UNISWAP_API_KEY=

# Slippage tolerance, in basis points, requested from the Uniswap Trading API
# (cross-lane request #32). LEAVE THIS SET. Unset, the API applies its own 250bps
# default, the harness compares that against Mandate.max_slippage_bps, and every
# plan under the golden mandate's 50bps ceiling is rejected on slippage — which
# reads as "the agent will not trade" rather than as a missing variable.
# 50 matches the golden mandate. Do not fix a rejection by loosening the mandate:
# a low-drawdown mandate advertising 3% slippage is what a judge checks, and the
# real fill was 0.035%.
UNISWAP_SLIPPAGE_BPS=50

# Base mainnet RPC, ARCHIVE-CAPABLE (Alchemy / QuickNode / dRPC free tier).
# `anvil --fork-url` needs archive access; the public mainnet.base.org is
# rate-limited and will crawl or fail under forking. Every lane sits on this.
BASE_RPC_URL=

# The Graph Studio → https://thegraph.com/studio → API Keys
# The x402 path deliberately needs no key, but x402 is the risky hand-rolled
# path — its fallback requires this. Free tier ~100K queries/month. Owner: Lane C.
GRAPH_API_KEY=

# ── Mainnet demo run (refine window, after 10:00) ─────────────────────────

# Fresh wallet, funded ~$20 + gas on Base. NEVER reuse a personal wallet.
DEPLOYER_PRIVATE_KEY=

# The curator agent's key — it executes directly, which IS the trust model.
# On the fork this is an anvil default account.
AGENT_PRIVATE_KEY=

# Wallet holding a few dollars of USDC on Base for x402 pay-per-query.
# Queries cost fractions of a cent. May be the same as AGENT_PRIVATE_KEY —
# the agent paying for its own data out of its own wallet is the narrative.
X402_PRIVATE_KEY=
X402_CHAIN=base

# https://basescan.org → free. For `forge verify-contract`; judges read source,
# and Uniswap's rules require the README to point at the contracts.
BASESCAN_API_KEY=

# ── Likely needed ─────────────────────────────────────────────────────────

# https://cloud.reown.com — only if Lane E uses RainbowKit or the
# WalletConnect connector. Injected-MetaMask-only avoids it entirely.
NEXT_PUBLIC_WALLETCONNECT_ID=

# ── Non-secret config ─────────────────────────────────────────────────────

# Local-first model layer. No API key — see master plan §1 (locked decision).
#
# MODEL_NAME is sized for CPU-only inference, MEASURED on the build machine
# (i5-8265U, no GPU, 16GB DDR4-2400) with `uv run python -m agent.bench`:
#   qwen2.5:3b-instruct-q4_K_M  -> ~40s per validated decision, 0 retries  ✅
#   a 14B at Q4                 -> ~9GB streamed per token, ~10min a tick  ❌
# Token generation is memory-bandwidth-bound, so this is about RAM speed, not
# cleverness. On a machine with a GPU, raise it and re-run agent.bench.
# Ollama tags are exact: pull this tag, not a similar one, or the harness
# reports GET /health as degraded (which is the point).
#
# ⚠️ Before a demo, export OLLAMA_KEEP_ALIVE=30m *in the Ollama server's own
# environment* — it is read by the server, not by this app, so putting it here
# does nothing unless you start Ollama from this env. Ollama evicts an idle
# model after ~5 min and the next tick then pays a ~2GB reload: a warm decision
# is ~33s, the first cold one exceeded a 120s budget. Passing `keep_alive` in
# the request body does NOT work — the OpenAI-compatible endpoint ignores it.
OLLAMA_BASE_URL=http://localhost:11434/v1
MODEL_NAME=qwen2.5:3b-instruct-q4_K_M

# Anvil fork. Bound to 0.0.0.0 so Windows clients can reach WSL — see §2.
ANVIL_RPC_URL=http://localhost:8540
CHAIN_ID=8453

# ── Optional Lane D (/venues) knobs — both fine left empty ────────────────

# Where the vault's execute() allowlist is read from. Lane D reads the deployed
# list rather than hardcoding it, because a GUARDIAN_ROLE can widen or narrow it
# after deploy (cross-lane request #1). Defaults to deployments/base-fork.json;
# point it at a mainnet manifest for the mainnet run.
DEPLOYMENTS_FILE=

# A deployed SwapVMProgramBuilder, if you have one. Normally unnecessary: the
# builder is a *pure* contract, so Lane D injects its runtime bytecode via an
# eth_call state override and runs it without deploying anything. Verified that
# the public mainnet.base.org supports overrides, as do anvil and Alchemy. Set
# this only if you move to an endpoint that does not.
AQUA_PROGRAM_BUILDER_ADDRESS=

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CHAIN_ID=8453
