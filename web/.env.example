# Copy to `web/.env.local` (gitignored) and adjust.
#
# Next.js only reads env files from its own project root, so these live here
# rather than in the repo-root .env — the values mirror the NEXT_PUBLIC_* block
# in the root .env.example. Only NEXT_PUBLIC_* variables reach the browser, and
# everything this app needs is public by nature: there are no secrets in the
# dApp. The agent holds the only key that matters.

# Lane B's FastAPI. Every read falls back to golden fixtures when this is
# unreachable, and the header badge turns amber to say so.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base chain id. The anvil fork keeps 8453, so this is the same either way.
NEXT_PUBLIC_CHAIN_ID=8453

# Read RPC for wallet balances and the ERC-4626 calls.
#   fork    → http://localhost:8540   (scripts/anvil-fork.sh binds 0.0.0.0)
#   mainnet → leave empty to use Base's public RPC, or paste an Alchemy URL
#
# A localhost value here also switches BaseScan links off: the fork reports
# chain id 8453 exactly like mainnet, so a link built from it would open a
# transaction that does not exist. See src/lib/chain/explorer.ts.
NEXT_PUBLIC_RPC_URL=http://localhost:8540

# Force fixture mode even when the API is reachable. Useful for demoing the UI
# offline. Leave unset normally — the app already falls back on its own.
# NEXT_PUBLIC_FIXTURES=1
